Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Enabled: true
  Name: root
  Global Options:
    Fixed Frame: calib_camera_optical
    Frame Rate: 30
    Background Color: 32; 32; 32
  Displays:
  - Class: rviz_default_plugins/TF
    Name: Sensor frames
    Enabled: true
    Show Names: true
    Show Axes: true
    Show Arrows: true
    Marker Scale: 0.2
  - Class: rviz_default_plugins/PointCloud2
    Name: Board returns
    Enabled: false
    Value: false
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /filtered_cloud
    Position Transformer: XYZ
    Color Transformer: FlatColor
    Color: 180; 180; 180
    Alpha: 1
    Size (Pixels): 3
    Size (m): 0.01
    Style: Points
    Decay Time: 0
    Use Fixed Frame: true
  - Class: rviz_default_plugins/PointCloud2
    Name: Camera hole centers
    Enabled: true
    Value: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /qr_cloud
    Position Transformer: XYZ
    Color Transformer: FlatColor
    Color: 80; 255; 80
    Alpha: 1
    Size (Pixels): 3
    Size (m): 0.04
    Style: Spheres
    Decay Time: 0
    Use Fixed Frame: true
  - Class: rviz_default_plugins/PointCloud2
    Name: LiDAR hole centers
    Enabled: true
    Value: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /center_cloud
    Position Transformer: XYZ
    Color Transformer: FlatColor
    Color: 255; 80; 80
    Alpha: 1
    Size (Pixels): 3
    Size (m): 0.025
    Style: Spheres
    Decay Time: 0
    Use Fixed Frame: true
  - Class: rviz_default_plugins/PointCloud2
    Name: Transformed LiDAR centers
    Enabled: false
    Value: false
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /aligned_lidar_centers
    Position Transformer: XYZ
    Color Transformer: FlatColor
    Color: 255; 220; 40
    Alpha: 1
    Size (Pixels): 3
    Size (m): 0.03
    Style: Spheres
    Decay Time: 0
    Use Fixed Frame: true
  - Class: rviz_default_plugins/PointCloud2
    Name: Hole boundaries
    Enabled: false
    Value: false
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /edge_cloud
    Position Transformer: XYZ
    Color Transformer: FlatColor
    Color: 80; 200; 255
    Alpha: 1
    Size (Pixels): 3
    Size (m): 0.01
    Style: Points
    Decay Time: 0
    Use Fixed Frame: true
  - Class: rviz_default_plugins/PointCloud2
    Name: Colored scene
    Enabled: false
    Value: false
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /colored_cloud
    Position Transformer: XYZ
    Color Transformer: RGB8
    Color: 255; 255; 255
    Alpha: 1
    Size (Pixels): 3
    Size (m): 0.01
    Style: Points
    Decay Time: 0
    Use Fixed Frame: true
  - Class: rviz_default_plugins/PointCloud2
    Name: Full LiDAR scene
    Enabled: true
    Value: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /calibration_scene
    Position Transformer: XYZ
    Color Transformer: AxisColor
    Axis: Z
    Autocompute Value Bounds:
      Value: false
      Min Value: 0.5
      Max Value: 8
    Use rainbow: true
    Alpha: 0.8
    Size (Pixels): 2
    Size (m): 0.01
    Style: Points
    Decay Time: 0
    Use Fixed Frame: true
  - Class: rviz_default_plugins/Camera
    Name: Camera view
    Enabled: true
    Value: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /calibration_camera/image_rect
    Image Rendering: background
    Overlay Alpha: 0.5
    Zoom Factor: 1
    Far Plane Distance: 100
    Visibility:
      Sensor frames: false
      Board returns: false
      Full LiDAR scene: true
      Camera hole centers: true
      LiDAR hole centers: true
  - Class: rviz_default_plugins/Image
    Name: Projection overlay
    Enabled: true
    Value: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /calibration_camera/overlay
    Normalize Range: true
    Min Value: 0
    Max Value: 1
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 2.0
      Focal Point:
        X: 0
        Y: 0
        Z: 2.0
      Pitch: -1.55
      Yaw: -1.5707963
      Near Clip Distance: 0.01
    Saved: []
Window Geometry:
  Width: 1600
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
